# Database
DATABASE_URL=postgresql://locales_user:locales_password@localhost:5432/locales_db

# Security
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (7 * 24 * 60 minutes)

# Environment
ENVIRONMENT=development
DEBUG=true

# OPENAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=1.0
OPENAI_TIMEOUT=120

# ANTHROPIC
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Scanner defaults (anthropic or openai)
SCANNER_DEFAULT_PROVIDER=anthropic

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Keeys App

# GitHub OAuth
# Create OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/github/callback
GITHUB_APP_SLUG=your-app-name  # From github.com/apps/{slug}

# Token Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
